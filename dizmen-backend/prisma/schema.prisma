generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  RESTAURANT_OWNER
  SUPER_ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
  role     Role   @default(RESTAURANT_OWNER)

  is_completed_profile   Boolean? @default(false)
  completed_profile_step Int?     @default(1)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  restaurants Restaurant[]
}

model Restaurant {
  id                Int      @id @default(autoincrement())
  restaurant_name   String
  address           String
  phone_number      String
  logo              String[] @default([])
  website           String[] @default([])
  map_link          String[] @default([])
  social_media_link String[] @default([])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
